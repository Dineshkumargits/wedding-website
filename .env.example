# PLACEHOLDERS ONLY — this file is committed to git.
# Put real values in .env.local, which is gitignored.
#
# Fill in from Supabase → Project Settings → API Keys
# (the current tab, NOT the .../api-keys/legacy one).
#
# SUPABASE_SECRET_KEY is the `sb_secret_...` key. It bypasses Row Level
# Security, so it is server-only: never prefix it with NEXT_PUBLIC_, and never
# import src/lib/db.ts into a Client Component.
#
# The legacy `service_role` key still works via SUPABASE_SERVICE_ROLE_KEY, but
# Supabase deprecates the legacy keys at the end of 2026 — prefer the secret key.
#
# Note: your database password is NOT used here. Only the URL and secret key.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
